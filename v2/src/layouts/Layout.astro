---
import '@/styles/global.css';
import { buildSeo, organizationJsonLd, websiteJsonLd, SITE_NAME, type SeoProps } from '@/lib/seo';
import Navbar from '../components/Navbar.tsx';
import Footer from '../components/Footer.tsx';

interface Props extends SeoProps {
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  bodyClass?: string;
  hideChrome?: boolean;
}

const { jsonLd, bodyClass, hideChrome = false, ...seoProps } = Astro.props;
const seo = buildSeo({
  ...seoProps,
  path: seoProps.path ?? Astro.url.pathname,
});

const jsonLdArr: Record<string, unknown>[] = [websiteJsonLd(), organizationJsonLd()];
if (Array.isArray(jsonLd)) jsonLdArr.push(...jsonLd);
else if (jsonLd) jsonLdArr.push(jsonLd);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0EA5E9" />
    <meta name="google-site-verification" content="tjvqekg8JTzZgH47iAPra0iuz-6pXgwg-DJpUkndndc" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    {seo.noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large" />
    )}

    <meta property="og:type" content={seo.type} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:image" content={seo.image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    {seo.type === 'article' && seo.publishedTime && (
      <meta property="article:published_time" content={seo.publishedTime} />
    )}
    {seo.type === 'article' && seo.modifiedTime && (
      <meta property="article:modified_time" content={seo.modifiedTime} />
    )}
    {seo.type === 'article' && seo.authorName && (
      <meta property="article:author" content={seo.authorName} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.image} />

    {jsonLdArr.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}

    <script is:inline>
      // Google Analytics. The 150 KB gtag.js is kept off the critical
      // path: dataLayer is queued immediately, but the script itself is
      // only injected on first interaction or once the browser is idle
      // (5s timeout fallback) — whichever comes first. Every visitor is
      // still counted; the request just no longer competes with FCP/LCP.
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-FVGM3QSCLC');
      (function () {
        var loaded = false;
        function loadGtag() {
          if (loaded) return;
          loaded = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-FVGM3QSCLC';
          document.head.appendChild(s);
        }
        ['scroll', 'pointerdown', 'keydown', 'touchstart'].forEach(function (evt) {
          window.addEventListener(evt, loadGtag, { once: true, passive: true });
        });
        if ('requestIdleCallback' in window) {
          requestIdleCallback(loadGtag, { timeout: 5000 });
        } else {
          window.addEventListener('load', function () { setTimeout(loadGtag, 3000); });
        }
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <a href="#main" class="skip-link">Aller au contenu</a>
    {!hideChrome && <Navbar client:load currentPath={Astro.url.pathname} />}
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    {!hideChrome && <Footer client:visible />}
    <slot name="footer" />
  </body>
</html>
