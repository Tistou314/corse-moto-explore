---
interface Crumb {
  name: string;
  path?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav aria-label="Fil d'Ariane" class="text-sm text-text-muted">
  <ol class="flex flex-wrap items-center gap-x-2">
    {items.map((c, i) => (
      <li class="flex items-center gap-2">
        {c.path && i < items.length - 1 ? (
          <a href={c.path} class="hover:text-accent">{c.name}</a>
        ) : (
          <span aria-current={i === items.length - 1 ? 'page' : undefined} class="text-text-primary">{c.name}</span>
        )}
        {i < items.length - 1 && <span aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>
