---
import { marked } from 'marked';

interface Props {
  markdown: string;
}
const { markdown } = Astro.props;

marked.setOptions({ gfm: true, breaks: false });
const html = await marked.parse(markdown ?? '');
---

<div
  class="prose prose-neutral max-w-prose mx-auto
    prose-headings:font-serif prose-headings:font-medium prose-headings:tracking-tight
    prose-h2:mt-16 prose-h2:mb-6 prose-h2:text-3xl md:prose-h2:text-4xl
    prose-h3:mt-12 prose-h3:mb-4 prose-h3:text-2xl
    prose-p:text-text-secondary prose-p:leading-[1.75] prose-p:text-[17px]
    prose-li:text-text-secondary prose-li:leading-[1.7]
    prose-a:text-accent prose-a:no-underline hover:prose-a:underline
    prose-strong:text-text-primary prose-strong:font-medium
    prose-blockquote:border-l-2 prose-blockquote:border-accent prose-blockquote:font-serif
    prose-blockquote:not-italic prose-blockquote:text-text-primary
    prose-img:rounded-none prose-img:w-full"
  set:html={html}
/>
