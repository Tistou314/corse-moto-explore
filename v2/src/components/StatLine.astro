---
interface Stat {
  label: string;
  value: string;
}
interface Props {
  items: Stat[];
}
const { items } = Astro.props;
---

<dl class="grid grid-cols-2 gap-y-6 gap-x-8 border-y border-border py-6 md:grid-cols-4 md:divide-x md:divide-border md:gap-0 md:py-8">
  {items.map((s, i) => (
    <div class={`md:px-6 ${i === 0 ? 'md:pl-0' : ''} ${i === items.length - 1 ? 'md:pr-0' : ''}`}>
      <dt class="text-xs uppercase tracking-[0.14em] text-text-muted">{s.label}</dt>
      <dd class="mt-2 font-serif text-2xl leading-tight text-text-primary md:text-3xl">{s.value}</dd>
    </div>
  ))}
</dl>
