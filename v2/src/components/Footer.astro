---
const year = new Date().getFullYear();
---

<footer class="mt-32 border-t border-border bg-bg-subtle">
  <div class="container grid gap-12 py-16 md:grid-cols-3">
    <div>
      <p class="font-serif text-xl text-text-primary">Corse à moto</p>
      <p class="mt-3 max-w-[36ch] text-sm text-text-secondary">
        Itinéraires testés, hébergements adaptés aux motards, conseils pratiques pour explorer la Corse à deux roues.
      </p>
    </div>
    <nav aria-label="Pages" class="text-sm">
      <p class="text-xs uppercase tracking-[0.14em] text-text-muted">Explorer</p>
      <ul class="mt-4 space-y-2 text-text-secondary">
        <li><a href="/itineraires" class="hover:text-accent">Itinéraires</a></li>
        <li><a href="/hebergements" class="hover:text-accent">Hébergements</a></li>
        <li><a href="/blog" class="hover:text-accent">Carnet de route</a></li>
        <li><a href="/stations-service" class="hover:text-accent">Stations stratégiques</a></li>
        <li><a href="/carte" class="hover:text-accent">Carte interactive</a></li>
      </ul>
    </nav>
    <nav aria-label="Site" class="text-sm">
      <p class="text-xs uppercase tracking-[0.14em] text-text-muted">Site</p>
      <ul class="mt-4 space-y-2 text-text-secondary">
        <li><a href="/guide-pratique" class="hover:text-accent">Guide pratique</a></li>
        <li><a href="/faq" class="hover:text-accent">Questions fréquentes</a></li>
        <li><a href="/contact" class="hover:text-accent">Contact</a></li>
      </ul>
    </nav>
  </div>
  <div class="border-t border-border">
    <div class="container py-6 text-sm text-text-muted">
      © {year} Corse à moto. Tous droits réservés.
    </div>
  </div>
</footer>
