---
import Layout from '@/layouts/Layout.astro';
import GuidePratiquePage from '@/components/pages/GuidePratiquePage';
import { breadcrumbJsonLd } from '@/lib/seo';

const jsonLd = breadcrumbJsonLd([
  { name: 'Accueil', path: '/' },
  { name: 'Guide pratique', path: '/guide-pratique' },
]);
---

<Layout
  title="Guide pratique de la Corse à moto : tout préparer en amont"
  description="Préparer un voyage moto en Corse : traversée ferry, équipement par saison, sécurité, règles de conduite locales, conseils itinéraires. Le guide complet."
  path="/guide-pratique"
  jsonLd={jsonLd}
>
  <GuidePratiquePage client:load />
</Layout>
