---
import AdminLayout from '@/layouts/AdminLayout.astro';
import EntityList from '@/components/admin/EntityList.tsx';
export const prerender = false;
---

<AdminLayout title="Articles">
  <EntityList
    client:only="react"
    table="blog_posts"
    title="Articles"
    newHref="/admin/blog/new"
    editHref={(id: string) => `/admin/blog/${id}`}
    searchKey="title"
    orderBy={{ column: 'published_at', ascending: false }}
    columns={[
      { key: 'title', label: 'Titre' },
      { key: 'category', label: 'Catégorie' },
      { key: 'published_at', label: 'Publié le', format: (r) => r.published_at ? String(r.published_at).slice(0, 10) : '—' },
      { key: 'reading_time', label: 'Lecture' },
      { key: 'published', label: 'En ligne', format: (r) => (r.published ? 'oui' : 'non') },
    ]}
  />
</AdminLayout>
