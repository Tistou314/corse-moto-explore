---
import AdminLayout from '@/layouts/AdminLayout.astro';
export const prerender = false;
---

<AdminLayout title="Tableau de bord">
  <h1 class="font-serif text-3xl">Tableau de bord</h1>
  <p class="mt-4 text-text-secondary max-w-prose">
    Cette interface permet de gérer le contenu publié sur corseamoto.com. Connecte-toi avec ton compte Supabase pour accéder aux CRUD.
  </p>

  <section class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {[
      ['/admin/itineraires', 'Itinéraires', 'Tracé, distance, dénivelé, étapes'],
      ['/admin/hebergements', 'Hébergements', 'Hôtels, gîtes, campings'],
      ['/admin/blog', 'Articles', 'Carnet de route'],
      ['/admin/stations', 'Stations-service', 'Cap Corse + stratégiques'],
      ['/admin/auteurs', 'Auteurs', 'Profils signataires'],
      ['/admin/poi', "Points d'intérêt", 'Étapes des itinéraires'],
    ].map(([href, title, desc]) => (
      <a href={href} class="block rounded-sm border border-border bg-bg p-6 transition hover:border-accent">
        <h2 class="font-serif text-xl">{title}</h2>
        <p class="mt-2 text-sm text-text-secondary">{desc}</p>
      </a>
    ))}
  </section>

  <section class="mt-16 border-t border-border pt-8">
    <p class="text-xs uppercase tracking-[0.14em] text-text-muted">Statut migration</p>
    <p class="mt-3 text-sm text-text-secondary">
      Schéma SQL en attente d'exécution dans Supabase. Une fois les tables créées, le script de migration (<code>scripts/migrate-data.ts</code>) injecte 10 itinéraires, 76 POI, 26 hébergements, 14 articles, 130 stations.
    </p>
  </section>
</AdminLayout>
