---
import Layout from '@/layouts/Layout.astro';
import { breadcrumbJsonLd } from '@/lib/seo';

const faqs = [
  {
    q: "Quelle est la meilleure période pour rouler en Corse à moto ?",
    a: "De mi-mai à fin juin, et de début septembre à mi-octobre. Températures clémentes (20 à 28°C), routes peu chargées, hébergements à des tarifs raisonnables. Juillet-août reste possible mais la chaleur (35°C+) et la fréquentation rendent l'expérience moins agréable.",
  },
  {
    q: "Combien de jours faut-il prévoir pour faire le tour de la Corse ?",
    a: "Sept jours pour un tour complet sans courir, dix à douze jours pour vraiment profiter, faire des détours et s'arrêter. Trois jours suffisent pour un thème (Cap Corse, Grand Sud, ou les calanques de Piana) mais ne permettent pas de faire le tour.",
  },
  {
    q: "Quels documents et équipements sont obligatoires ?",
    a: "Permis A ou A2, carte grise, attestation d'assurance, casque homologué, gants homologués. Recommandés : gilet jaune (sortie d'autoroute), trousse de secours, ampoules de rechange. Pour la traversée : pièce d'identité, billet de ferry.",
  },
  {
    q: "Y a-t-il assez de stations-service pour rouler sereinement ?",
    a: "Globalement oui sur l'axe Bastia-Ajaccio-Bonifacio, mais le Cap Corse, le centre montagneux et certaines portions du sud comptent peu de stations. Notre carte des stations stratégiques liste les points clés.",
  },
  {
    q: "Quel type de moto privilégier ?",
    a: "Trail, roadster ou GT polyvalent. Les routes sont étroites et sinueuses : une supersport est punitive, une grosse routière manque d'agilité. Idéalement : 600 à 1000 cc, position confortable, suspensions souples.",
  },
  {
    q: "Combien coûte un voyage moto d'une semaine en Corse ?",
    a: "Entre 700 et 1500 € par personne hors essence et selon la saison : traversée (200-300 € aller-retour moto + 1 personne), hébergement (50-150 €/nuit selon catégorie), repas (30-50 €/jour), entrées et activités.",
  },
];

const jsonLd: Record<string, unknown>[] = [
  breadcrumbJsonLd([{ name: 'Accueil', path: '/' }, { name: 'FAQ', path: '/faq' }]),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Layout
  title="FAQ - Questions Fréquentes Moto Corse | Conseils & Réponses"
  description="Toutes les réponses aux questions fréquentes sur les voyages moto en Corse : meilleure période, ferry, équipement, itinéraires et conseils pratiques."
  path="/faq"
  jsonLd={jsonLd}
>
  <div class="bg-gray-50 py-16 min-h-screen">
    <div class="container mx-auto px-4">
      <div class="mb-12 text-center pt-20">
        <h1 class="text-4xl md:text-5xl font-bold mb-4 text-corsica-charcoal font-heading">
          Foire Aux Questions
        </h1>
        <p class="text-lg text-corsica-slate max-w-3xl mx-auto">
          Retrouvez les réponses aux questions les plus fréquentes sur la découverte de la Corse à moto.
        </p>
      </div>

      <div class="max-w-4xl mx-auto bg-white rounded-xl shadow-md p-6 md:p-8">
        <ul class="space-y-4">
          {faqs.map((f, i) => (
            <li>
              <details class="group border-b border-gray-200 pb-4">
                <summary class="cursor-pointer list-none text-lg font-medium text-corsica-charcoal py-4 hover:text-corsica-azure transition-colors flex items-start justify-between gap-6">
                  <span>{f.q}</span>
                  <span aria-hidden="true" class="mt-1 text-corsica-azure transition group-open:rotate-45 text-xl">+</span>
                </summary>
                <p class="text-corsica-slate pb-2 pt-2 leading-relaxed">{f.a}</p>
              </details>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</Layout>
