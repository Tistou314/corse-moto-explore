---
import Layout from '@/layouts/Layout.astro';
---

<Layout
  title="Corse à moto, itinéraires et hébergements pour rouler l'île"
  description="Itinéraires moto sélectionnés, hébergements adaptés aux motards, stations-service stratégiques et guide pratique pour explorer la Corse à deux roues."
  path="/"
>
  <section class="container py-24 md:py-32">
    <p class="text-sm uppercase tracking-[0.18em] text-text-muted">Guide éditorial</p>
    <h1 class="mt-4 font-serif text-[clamp(2.25rem,5vw+1rem,4.5rem)] font-medium leading-[1.05] tracking-tight">
      La Corse, route après route.
    </h1>
    <p class="mt-6 max-w-prose text-lg text-text-secondary">
      Huit itinéraires testés, vingt-six hébergements pensés pour les motards, des stations stratégiques et un guide pratique pour préparer chaque étape.
    </p>
  </section>
</Layout>
