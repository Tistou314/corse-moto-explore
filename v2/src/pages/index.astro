---
import Layout from '@/layouts/Layout.astro';
import HomePage from '@/components/pages/HomePage';
import { allItineraries, allAccommodations, allBlogPosts } from '@/lib/data';

const featuredItineraries = allItineraries.slice(0, 3);
const recentPosts = allBlogPosts
  .slice()
  .sort((a, b) => (b.isoDate ?? '').localeCompare(a.isoDate ?? ''))
  .slice(0, 3);
const featuredHotels = allAccommodations.filter((a) => a.type === 'hotel').slice(0, 3);
const featuredCampings = allAccommodations.filter((a) => a.type === 'camping').slice(0, 3);
const featuredGites = allAccommodations.filter((a) => a.type === 'gite').slice(0, 3);
---

<Layout
  title="Corse à moto : itinéraires, hébergements et guide pratique"
  description="Le guide indépendant pour préparer son voyage moto en Corse. Itinéraires testés au guidon, hébergements adaptés aux motards, conseils saisonniers, stations-service."
  path="/"
>
  <HomePage
    client:load
    featuredItineraries={featuredItineraries}
    recentPosts={recentPosts}
    featuredHotels={featuredHotels}
    featuredCampings={featuredCampings}
    featuredGites={featuredGites}
  />
</Layout>
