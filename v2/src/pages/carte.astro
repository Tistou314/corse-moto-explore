---
import Layout from '@/layouts/Layout.astro';
import Map from '@/components/Map.tsx';
import { allItineraries, allAccommodations, allGasStations } from '@/lib/data';
import { breadcrumbJsonLd } from '@/lib/seo';

const maptilerKey = import.meta.env.PUBLIC_MAPTILER_KEY ?? '';

const markers = [
  ...allItineraries
    .filter((it) => typeof it.latitude === 'number' && typeof it.longitude === 'number')
    .map((it) => ({
      id: `it-${it.slug}`,
      name: it.title,
      latitude: it.latitude!,
      longitude: it.longitude!,
      type: 'itinerary' as const,
      href: `/itineraires/${it.slug}`,
    })),
  ...allAccommodations
    .filter((a) => typeof a.latitude === 'number' && typeof a.longitude === 'number')
    .map((a) => ({
      id: `ac-${a.slug}`,
      name: a.name,
      latitude: a.latitude!,
      longitude: a.longitude!,
      type: 'accommodation' as const,
      href: `/hebergements/${a.slug}`,
    })),
  ...allGasStations
    .filter((g) => typeof g.latitude === 'number' && typeof g.longitude === 'number')
    .map((g) => ({
      id: `gs-${g.id}`,
      name: g.name + (g.brand ? ` · ${g.brand}` : ''),
      latitude: g.latitude,
      longitude: g.longitude,
      type: 'gas-station' as const,
    })),
];
---

<Layout
  title="Carte Interactive Moto Corse - Itinéraires, Hébergements et Stations"
  description="Carte interactive de la Corse à moto, regroupant itinéraires, hébergements adaptés aux motards et stations-service utiles."
  path="/carte"
  jsonLd={breadcrumbJsonLd([{ name: 'Accueil', path: '/' }, { name: 'Carte', path: '/carte' }])}
>
  <div class="container mx-auto px-4 py-8 pt-24">
    <div class="max-w-3xl mb-8">
      <h1 class="text-4xl md:text-5xl font-bold mb-4 text-corsica-charcoal font-heading">Carte interactive</h1>
      <p class="text-lg text-corsica-slate">
        Tous les itinéraires, hébergements et stations-service sur un seul fond. Pince ou utilise la molette pour zoomer, clique sur un point pour ouvrir la fiche.
      </p>
      <div class="mt-6 flex flex-wrap gap-x-8 gap-y-2 text-sm text-corsica-slate">
        <span class="inline-flex items-center gap-2"><span class="inline-block h-3 w-3 rounded-full bg-corsica-azure"></span> Itinéraires</span>
        <span class="inline-flex items-center gap-2"><span class="inline-block h-3 w-3 rounded-full bg-corsica-emerald"></span> Hébergements</span>
        <span class="inline-flex items-center gap-2"><span class="inline-block h-3 w-3 rounded-full bg-corsica-coral"></span> Stations-service</span>
      </div>
    </div>

    <Map client:only="react" markers={markers} maptilerKey={maptilerKey} height="72vh" />
  </div>
</Layout>
