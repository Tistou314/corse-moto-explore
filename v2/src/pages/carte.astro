---
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Map from '@/components/Map.tsx';
import { allItineraries, allAccommodations, allGasStations } from '@/lib/data';
import { breadcrumbJsonLd } from '@/lib/seo';

const maptilerKey = import.meta.env.PUBLIC_MAPTILER_KEY ?? '';

const markers = [
  ...allItineraries
    .filter((it) => typeof it.latitude === 'number' && typeof it.longitude === 'number')
    .map((it) => ({
      id: `it-${it.slug}`,
      name: it.title,
      latitude: it.latitude!,
      longitude: it.longitude!,
      type: 'itinerary' as const,
      href: `/itineraires/${it.slug}`,
    })),
  ...allAccommodations
    .filter((a) => typeof a.latitude === 'number' && typeof a.longitude === 'number')
    .map((a) => ({
      id: `ac-${a.slug}`,
      name: a.name,
      latitude: a.latitude!,
      longitude: a.longitude!,
      type: 'accommodation' as const,
      href: `/hebergements/${a.slug}`,
    })),
  ...allGasStations
    .filter((g) => typeof g.latitude === 'number' && typeof g.longitude === 'number')
    .map((g) => ({
      id: `gs-${g.id}`,
      name: g.name + (g.brand ? ` · ${g.brand}` : ''),
      latitude: g.latitude,
      longitude: g.longitude,
      type: 'gas-station' as const,
    })),
];
---

<Layout
  title="Carte interactive — Itinéraires, hébergements et stations en Corse"
  description="Carte interactive de la Corse à moto, regroupant itinéraires, hébergements adaptés aux motards et stations-service utiles."
  path="/carte"
  jsonLd={breadcrumbJsonLd([{ name: 'Accueil', path: '/' }, { name: 'Carte', path: '/carte' }])}
>
  <Navbar slot="header" />
  <Footer slot="footer" />

  <section class="container pt-12 md:pt-16">
    <Breadcrumbs items={[{ name: 'Accueil', path: '/' }, { name: 'Carte' }]} />
    <div class="mt-8 max-w-prose">
      <h1 class="font-serif text-[clamp(2rem,3vw+1rem,3.75rem)] font-medium leading-tight tracking-tight">Carte interactive</h1>
      <p class="mt-6 text-lg text-text-secondary">
        Tous les itinéraires, hébergements et stations-service sur un seul fond. Pince ou utilise la molette pour zoomer, clique sur un point pour ouvrir la fiche.
      </p>
      <div class="mt-6 flex flex-wrap gap-x-8 gap-y-2 text-sm text-text-secondary">
        <span class="inline-flex items-center gap-2"><span class="inline-block h-2.5 w-2.5 rounded-full" style="background:#1a3a5c"></span> Itinéraires</span>
        <span class="inline-flex items-center gap-2"><span class="inline-block h-2.5 w-2.5 rounded-full" style="background:#7a5230"></span> Hébergements</span>
        <span class="inline-flex items-center gap-2"><span class="inline-block h-2.5 w-2.5 rounded-full" style="background:#5a5a5a"></span> Stations-service</span>
      </div>
    </div>
  </section>

  <section class="mt-12 mb-32">
    <div class="container">
      <Map client:only="react" markers={markers} maptilerKey={maptilerKey} height="72vh" />
    </div>
  </section>
</Layout>
