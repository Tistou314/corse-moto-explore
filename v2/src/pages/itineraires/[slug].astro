---
import Layout from '@/layouts/Layout.astro';
import ItineraryDetailPage from '@/components/pages/ItineraryDetailPage';
import { allItineraries } from '@/lib/data';
import { breadcrumbJsonLd } from '@/lib/seo';
import { absoluteUrl } from '@/lib/utils';

export async function getStaticPaths() {
  return allItineraries.map((it) => ({ params: { slug: it.slug }, props: { it } }));
}

const { it } = Astro.props as { it: (typeof allItineraries)[number] };

const nearby = allItineraries.filter((x) => x.slug !== it.slug && x.region === it.region);

const touristTripSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'TouristTrip',
  name: it.title,
  description: it.description,
  url: absoluteUrl(`/itineraires/${it.slug}`),
  image: it.heroImage,
  touristType: 'Motorcyclist',
  itinerary: {
    '@type': 'ItemList',
    itemListElement: it.pointsOfInterest.map((p, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      item: {
        '@type': 'Place',
        name: p.name,
        ...(p.description && { description: p.description }),
        ...(typeof p.latitude === 'number' &&
          typeof p.longitude === 'number' && {
            geo: {
              '@type': 'GeoCoordinates',
              latitude: p.latitude,
              longitude: p.longitude,
            },
          }),
      },
    })),
  },
};

if (typeof it.latitude === 'number' && typeof it.longitude === 'number') {
  touristTripSchema.geo = {
    '@type': 'GeoCoordinates',
    latitude: it.latitude,
    longitude: it.longitude,
  };
}

const jsonLd: Record<string, unknown>[] = [
  breadcrumbJsonLd([
    { name: 'Accueil', path: '/' },
    { name: 'Itinéraires', path: '/itineraires' },
    { name: it.title, path: `/itineraires/${it.slug}` },
  ]),
  touristTripSchema,
];

// Normalize distance: data sometimes carries "km" already (e.g. "110 km"),
// sometimes just the number. Strip and re-append cleanly so we don't end
// up with "kmkm" in the title.
const distanceNum = String(it.distance ?? '').replace(/\s*km\s*$/i, '').trim();
const distanceStr = distanceNum ? `${distanceNum} km` : '';

// Short, human description: drop the legacy data quirks (trailing "..."),
// trim to ~115 chars to leave room for the meta-stats appended below.
const baseDesc = (it.description || '')
  .replace(/\.{3,}\s*$/, '')
  .replace(/\s+/g, ' ')
  .trim();
const shortDesc = baseDesc.length > 115 ? baseDesc.slice(0, 112).trimEnd() + '…' : baseDesc;
const metaStats = [distanceStr, it.duration, it.difficulty].filter(Boolean).join(' · ');
const metaDescription = `${shortDesc} ${metaStats ? `(${metaStats})` : ''}`.trim();

const metaTitle = [it.title, distanceStr ? `${distanceStr} à moto en Corse` : 'Itinéraire moto en Corse']
  .filter(Boolean)
  .join(' — ');
---

<Layout
  title={metaTitle}
  description={metaDescription}
  path={`/itineraires/${it.slug}`}
  image={it.heroImage}
  jsonLd={jsonLd}
>
  <ItineraryDetailPage client:load itinerary={it} nearbyItineraries={nearby} />
</Layout>
