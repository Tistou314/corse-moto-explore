---
import Layout from '@/layouts/Layout.astro';
import ItineraryDetailPage from '@/components/pages/ItineraryDetailPage';
import { allItineraries } from '@/lib/data';
import { breadcrumbJsonLd } from '@/lib/seo';
import { absoluteUrl } from '@/lib/utils';

export async function getStaticPaths() {
  return allItineraries.map((it) => ({ params: { slug: it.slug }, props: { it } }));
}

const { it } = Astro.props as { it: (typeof allItineraries)[number] };

const nearby = allItineraries.filter((x) => x.slug !== it.slug && x.region === it.region);

const jsonLd: Record<string, unknown>[] = [
  breadcrumbJsonLd([
    { name: 'Accueil', path: '/' },
    { name: 'Itinéraires', path: '/itineraires' },
    { name: it.title, path: `/itineraires/${it.slug}` },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'TouristTrip',
    name: it.title,
    description: it.description,
    url: absoluteUrl(`/itineraires/${it.slug}`),
    image: it.heroImage,
    touristType: 'Motorcyclist',
    itinerary: {
      '@type': 'ItemList',
      itemListElement: it.pointsOfInterest.map((p, idx) => ({
        '@type': 'ListItem',
        position: idx + 1,
        item: { '@type': 'Place', name: p.name, description: p.description },
      })),
    },
  },
];
---

<Layout
  title={`${it.title} - Itinéraire Moto ${it.region} | ${it.distance}km`}
  description={`${it.description.substring(0, 150)}... Difficulté: ${it.difficulty}. Durée: ${it.duration}.`}
  path={`/itineraires/${it.slug}`}
  image={it.heroImage}
  jsonLd={jsonLd}
>
  <ItineraryDetailPage client:load itinerary={it} nearbyItineraries={nearby} />
</Layout>
