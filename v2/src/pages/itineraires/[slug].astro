---
import Layout from '@/layouts/Layout.astro';
import ItineraryDetailPage from '@/components/pages/ItineraryDetailPage';
import ItineraryHero from '@/components/legacy-overrides/ItineraryHero';
import { allItineraries } from '@/lib/data';
import { breadcrumbJsonLd, seoImageUrl } from '@/lib/seo';
import { absoluteUrl, heroImageSrc, thumbVariant } from '@/lib/utils';

export async function getStaticPaths() {
  return allItineraries.map((it) => ({ params: { slug: it.slug }, props: { it } }));
}

const { it } = Astro.props as { it: (typeof allItineraries)[number] };

// The sidebar only renders id/title/description/image for up to 3 nearby
// itineraries. Trim to those fields so each one's full markdown body
// isn't serialized into the island props (~15 KB of dead HTML each).
const nearby = allItineraries
  .filter((x) => x.slug !== it.slug && x.region === it.region)
  .slice(0, 3)
  .map((x) => ({
    id: x.id,
    slug: x.slug,
    title: x.title,
    description: x.description,
    // The sidebar shows this at 64px — serve the lightweight thumbnail.
    image: thumbVariant(x.image),
    heroImage: x.heroImage,
  })) as unknown as typeof allItineraries;

const touristTripSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'TouristTrip',
  name: it.title,
  description: it.description,
  url: absoluteUrl(`/itineraires/${it.slug}`),
  image: seoImageUrl(it.heroImage),
  touristType: 'Motorcyclist',
  itinerary: {
    '@type': 'ItemList',
    itemListElement: it.pointsOfInterest.map((p, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      item: {
        '@type': 'Place',
        name: p.name,
        ...(p.description && { description: p.description }),
        ...(typeof p.latitude === 'number' &&
          typeof p.longitude === 'number' && {
            geo: {
              '@type': 'GeoCoordinates',
              latitude: p.latitude,
              longitude: p.longitude,
            },
          }),
      },
    })),
  },
};

if (typeof it.latitude === 'number' && typeof it.longitude === 'number') {
  touristTripSchema.geo = {
    '@type': 'GeoCoordinates',
    latitude: it.latitude,
    longitude: it.longitude,
  };
}

const jsonLd: Record<string, unknown>[] = [
  breadcrumbJsonLd([
    { name: 'Accueil', path: '/' },
    { name: 'Itinéraires', path: '/itineraires' },
    { name: it.title, path: `/itineraires/${it.slug}` },
  ]),
  touristTripSchema,
];

// Normalize distance: data sometimes carries "km" already (e.g. "110 km"
// or "150 km (Ajaccio-Corte-Bastia)"), sometimes just the number. If "km"
// is anywhere in the string, leave it as-is; otherwise append " km".
const distanceRaw = String(it.distance ?? '').trim();
const distanceStr = distanceRaw
  ? /\bkm\b/i.test(distanceRaw)
    ? distanceRaw
    : `${distanceRaw} km`
  : '';

// Short, human description: drop the legacy data quirks (trailing "..."),
// trim to ~115 chars to leave room for the meta-stats appended below.
const baseDesc = (it.description || '')
  .replace(/\.{3,}\s*$/, '')
  .replace(/\s+/g, ' ')
  .trim();
const metaStats = [distanceStr, it.duration, it.difficulty].filter(Boolean).join(' · ');
// Budget the base text so base + appended stats stays ≤ 158 chars.
const maxBase = Math.min(115, 157 - (metaStats ? metaStats.length + 3 : 0));
const shortDesc =
  baseDesc.length > maxBase ? baseDesc.slice(0, maxBase - 1).trimEnd() + '…' : baseDesc;
const metaDescription = `${shortDesc} ${metaStats ? `(${metaStats})` : ''}`.trim();

// Title: distances like "150 km (Ajaccio-Corte-Bastia)" carry route detail
// that blows past Google's ~62-char display limit — keep only the number
// in the <title>; the full detail stays on the page and in the description.
const stripParens = (s: string) => s.replace(/\s*\([^)]*\)\s*/g, ' ').replace(/\s+/g, ' ').trim();
const distanceForTitle = stripParens(distanceStr);
let metaTitle = [it.title, distanceForTitle ? `${distanceForTitle} à moto en Corse` : 'Itinéraire moto en Corse']
  .filter(Boolean)
  .join(' : ');
if (metaTitle.length > 62) {
  metaTitle = [stripParens(it.title), distanceForTitle ? `${distanceForTitle} à moto en Corse` : 'Itinéraire moto en Corse']
    .filter(Boolean)
    .join(' : ');
}
---

<Layout
  title={metaTitle}
  description={metaDescription}
  path={`/itineraires/${it.slug}`}
  image={it.heroImage}
  {/* Must resolve exactly like ItineraryHero, or the preload misses and the
      browser fetches the hero twice. */}
  preloadImage={heroImageSrc((it as typeof it & { image?: string }).image ?? it.heroImage)}
  jsonLd={jsonLd}
>
  <ItineraryHero itinerary={it} />
  <ItineraryDetailPage client:load itinerary={it} nearbyItineraries={nearby} />
</Layout>
