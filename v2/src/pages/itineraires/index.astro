---
import Layout from '@/layouts/Layout.astro';
import ItinerairesPage from '@/components/pages/ItinerairesPage';
import { allItineraries } from '@/lib/data';
import { breadcrumbJsonLd, itemListJsonLd } from '@/lib/seo';

const jsonLd: Record<string, unknown>[] = [
  breadcrumbJsonLd([
    { name: 'Accueil', path: '/' },
    { name: 'Itinéraires', path: '/itineraires' },
  ]),
  itemListJsonLd(
    'Itinéraires moto en Corse',
    allItineraries.map((it) => ({
      url: `/itineraires/${it.slug}`,
      name: it.title,
      image: it.heroImage,
      description: it.description,
    })),
  ),
];
---

<Layout
  title="Itinéraires moto en Corse : 10 boucles testées au guidon"
  description="Cap Corse, Calanques de Piana, Bavella, Castagniccia : une sélection serrée d'itinéraires moto avec dénivelés, durées, difficultés et conseils route."
  path="/itineraires"
  jsonLd={jsonLd}
>
  <ItinerairesPage client:load itineraries={allItineraries} />
</Layout>
