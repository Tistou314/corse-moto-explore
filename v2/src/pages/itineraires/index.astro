---
import Layout from '@/layouts/Layout.astro';
import ItinerairesPage from '@/components/pages/ItinerairesPage';
import { allItineraries } from '@/lib/data';
import { breadcrumbJsonLd } from '@/lib/seo';

const jsonLd = breadcrumbJsonLd([
  { name: 'Accueil', path: '/' },
  { name: 'Itinéraires', path: '/itineraires' },
]);
---

<Layout
  title="Itinéraires Moto en Corse - Les Plus Belles Routes de l'Île de Beauté"
  description="Découvrez les plus beaux itinéraires moto de Corse : routes panoramiques, cols mythiques et parcours adaptés à tous les niveaux. Traces GPS incluses."
  path="/itineraires"
  jsonLd={jsonLd}
>
  <ItinerairesPage client:load itineraries={allItineraries} />
</Layout>
