---
import Layout from '@/layouts/Layout.astro';
import HebergementsPage from '@/components/pages/HebergementsPage';
import { allAccommodations } from '@/lib/data';
import { breadcrumbJsonLd, itemListJsonLd } from '@/lib/seo';

const jsonLd: Record<string, unknown>[] = [
  breadcrumbJsonLd([
    { name: 'Accueil', path: '/' },
    { name: 'Hébergements', path: '/hebergements' },
  ]),
  itemListJsonLd(
    'Hébergements moto en Corse',
    allAccommodations.map((a) => ({
      url: `/hebergements/${a.slug}`,
      name: a.name,
      image: a.heroImage,
      description: a.description,
    })),
  ),
];
---

<Layout
  title="Hébergements motards en Corse : hôtels, gîtes et campings"
  description="26 hébergements adaptés à la moto en Corse : parking sécurisé, séchage équipement, conseils itinéraires. Filtres par type, région et budget."
  path="/hebergements"
  jsonLd={jsonLd}
>
  <HebergementsPage client:load accommodations={allAccommodations} />
</Layout>
