---
import Layout from '@/layouts/Layout.astro';
import HebergementsPage from '@/components/pages/HebergementsPage';
import { allAccommodations } from '@/lib/data';
import { breadcrumbJsonLd, itemListJsonLd } from '@/lib/seo';

const jsonLd: Record<string, unknown>[] = [
  breadcrumbJsonLd([
    { name: 'Accueil', path: '/' },
    { name: 'Hébergements', path: '/hebergements' },
  ]),
  itemListJsonLd(
    'Hébergements moto en Corse',
    allAccommodations.map((a) => ({
      url: `/hebergements/${a.slug}`,
      name: a.name,
      image: a.heroImage,
      description: a.description,
    })),
  ),
];
---

<Layout
  title="Hébergements Moto en Corse - Hôtels, Gîtes & Campings pour Motards"
  description="Trouvez le logement parfait pour votre voyage moto en Corse : hôtels, gîtes et campings adaptés aux motards avec parking sécurisé et services dédiés."
  path="/hebergements"
  jsonLd={jsonLd}
>
  <HebergementsPage client:load accommodations={allAccommodations} />
</Layout>
