---
import Layout from '@/layouts/Layout.astro';
import AccommodationDetailPage from '@/components/pages/AccommodationDetailPage';
import { allAccommodations } from '@/lib/data';
import { breadcrumbJsonLd, seoImageUrl } from '@/lib/seo';
import { absoluteUrl } from '@/lib/utils';

export async function getStaticPaths() {
  return allAccommodations.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}

const { a } = Astro.props as { a: (typeof allAccommodations)[number] };

const typeLabel = { hotel: 'Hôtel', gite: 'Gîte', camping: 'Camping' }[a.type];
const schemaType = a.type === 'hotel' ? 'Hotel' : a.type === 'camping' ? 'Campground' : 'LodgingBusiness';

const accommodationSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  name: a.name,
  description: a.description,
  url: absoluteUrl(`/hebergements/${a.slug}`),
  image: seoImageUrl(a.heroImage),
  priceRange: a.priceRange,
};

if (a.address || a.location) {
  accommodationSchema.address = {
    '@type': 'PostalAddress',
    streetAddress: a.address ?? a.location,
    addressLocality: a.location,
    addressRegion: capitalize(a.region),
    addressCountry: 'FR',
  };
}

if (typeof a.latitude === 'number' && typeof a.longitude === 'number') {
  accommodationSchema.geo = {
    '@type': 'GeoCoordinates',
    latitude: a.latitude,
    longitude: a.longitude,
  };
}

if (a.contact?.phone) accommodationSchema.telephone = a.contact.phone;
if (a.contact?.email) accommodationSchema.email = a.contact.email;
if (a.contact?.website) accommodationSchema.sameAs = [a.contact.website];

// Note: no aggregateRating markup. We only hold a single editorial score
// per establishment, and Google's structured-data guidelines require
// genuine aggregated user reviews — a ratingCount of 1 from the site
// owner risks a "misleading structured data" manual action.

if (a.amenities && a.amenities.length > 0) {
  accommodationSchema.amenityFeature = a.amenities.map((name: string) => ({
    '@type': 'LocationFeatureSpecification',
    name,
    value: true,
  }));
}

const jsonLd: Record<string, unknown>[] = [
  breadcrumbJsonLd([
    { name: 'Accueil', path: '/' },
    { name: 'Hébergements', path: '/hebergements' },
    { name: a.name, path: `/hebergements/${a.slug}` },
  ]),
  accommodationSchema,
];

// Capitalize location name (Supabase data can be lowercase like "ajaccio")
function capitalize(str: string | undefined): string {
  if (!str) return '';
  return str
    .split(/(\s|-)/)
    .map((part) => (part.match(/^[a-zA-ZÀ-ÿ]/) ? part[0].toUpperCase() + part.slice(1) : part))
    .join('');
}

const locationLabel = capitalize(a.location || a.region || 'Corse');

// Title: aim for ≤ 62 chars so Google doesn't truncate. Parentheticals in
// establishment/location names ("(gîte d'étape)", "(Niolu)") are the first
// thing to go, then the wording is tightened, then the locality.
const stripParens = (s: string) => s.replace(/\s*\([^)]*\)\s*/g, ' ').replace(/\s+/g, ' ').trim();
const nameShort = stripParens(a.name);
const locationShort = stripParens(locationLabel);
let metaTitle = `${nameShort} : ${typeLabel} adapté motards à ${locationShort}`;
if (metaTitle.length > 62) metaTitle = `${nameShort} : ${typeLabel} motard à ${locationShort}`;
if (metaTitle.length > 62) metaTitle = `${nameShort} : ${typeLabel} motard en Corse`;

// Short, clean description: drop trailing ellipses, then budget the base
// text so that base + appended structured info stays ≤ 158 chars.
const baseDesc = (a.description || '')
  .replace(/\.{3,}\s*$/, '')
  .replace(/\s+/g, ' ')
  .trim();
const topAmenities = (a.bikerAmenities || []).slice(0, 2).join(', ').toLowerCase();
const priceTag = a.priceRange ? `Dès ${a.priceRange.split('-')[0].trim()}` : '';
const tail = [topAmenities, priceTag].filter(Boolean).join(' · ');
const maxBase = Math.min(100, 157 - (tail ? tail.length + 2 : 0));
const shortDesc =
  baseDesc.length > maxBase ? baseDesc.slice(0, maxBase - 1).trimEnd() + '…' : baseDesc;
const metaDescription = tail ? `${shortDesc} ${tail}.` : shortDesc;
---

<Layout
  title={metaTitle}
  description={metaDescription}
  path={`/hebergements/${a.slug}`}
  image={a.heroImage}
  preloadImage={a.heroImage}
  jsonLd={jsonLd}
>
  <AccommodationDetailPage client:load accommodation={a} />
</Layout>
