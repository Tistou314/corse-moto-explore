---
import Layout from '@/layouts/Layout.astro';
import ContactPage from '@/components/pages/ContactPage';
import { breadcrumbJsonLd } from '@/lib/seo';

const jsonLd: Record<string, unknown>[] = [
  breadcrumbJsonLd([{ name: 'Accueil', path: '/' }, { name: 'Contact', path: '/contact' }]),
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'La Corse à Moto',
    url: 'https://corseamoto.com',
    contactPoint: [
      {
        '@type': 'ContactPoint',
        contactType: 'editorial',
        email: 'contact@lacorseamoto.fr',
        availableLanguage: 'French',
      },
    ],
  },
];
---

<Layout
  title="Contact - La Corse à Moto | Questions & Conseils"
  description="Contactez-nous pour toute question sur vos itinéraires moto en Corse, hébergements ou conseils de voyage. Réponse rapide et personnalisée."
  path="/contact"
  jsonLd={jsonLd}
>
  <ContactPage client:load />
</Layout>
