---
import Layout from '@/layouts/Layout.astro';
import ContactPage from '@/components/pages/ContactPage';
import { breadcrumbJsonLd, SITE_NAME } from '@/lib/seo';
import { SITE_URL, absoluteUrl } from '@/lib/utils';

const jsonLd: Record<string, unknown>[] = [
  breadcrumbJsonLd([{ name: 'Accueil', path: '/' }, { name: 'Contact', path: '/contact' }]),
  {
    '@context': 'https://schema.org',
    '@type': 'TouristInformationCenter',
    name: SITE_NAME,
    description:
      "Guide indépendant des voyages moto en Corse : itinéraires, hébergements adaptés aux motards, conseils saisonniers, stations-service stratégiques.",
    url: SITE_URL,
    image: absoluteUrl('/og/default.svg'),
    email: 'pitameternam@gmail.com',
    areaServed: {
      '@type': 'AdministrativeArea',
      name: 'Corse',
    },
    address: {
      '@type': 'PostalAddress',
      addressRegion: 'Corse',
      addressCountry: 'FR',
    },
    contactPoint: [
      {
        '@type': 'ContactPoint',
        contactType: 'editorial',
        email: 'pitameternam@gmail.com',
        availableLanguage: 'French',
      },
    ],
    inLanguage: 'fr-FR',
  },
];
---

<Layout
  title="Contact — Corse à moto"
  description="Une question sur un itinéraire, un hébergement à recommander, une suggestion pour le guide ? Écrivez-nous, on répond en quelques jours."
  path="/contact"
  jsonLd={jsonLd}
>
  <ContactPage client:load />
</Layout>
