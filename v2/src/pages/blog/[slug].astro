---
import Layout from '@/layouts/Layout.astro';
import BlogPostDetailPage from '@/components/pages/BlogPostDetailPage';
import { allBlogPosts } from '@/lib/data';
import { getBlogOverride } from '@/lib/blog-content-overrides';
import { formatContent } from '../../../../src/utils/markdown/markdownFormatter';
import { breadcrumbJsonLd } from '@/lib/seo';
import { absoluteUrl } from '@/lib/utils';

export async function getStaticPaths() {
  return allBlogPosts.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props as {
  p: (typeof allBlogPosts)[number] & { faq?: { q: string; a: string }[] };
};

const sorted = allBlogPosts.slice().sort((a, b) => (b.isoDate ?? '').localeCompare(a.isoDate ?? ''));
const idx = sorted.findIndex((x) => x.slug === p.slug);
// The prev/next links render a slug and a title, nothing more.
const trimNav = (x: (typeof allBlogPosts)[number] | undefined) =>
  x ? ({ id: x.id, slug: x.slug, title: x.title } as unknown as typeof x) : null;
const prevPost = idx > 0 ? trimNav(sorted[idx - 1]) : null;
const nextPost = idx >= 0 && idx < sorted.length - 1 ? trimNav(sorted[idx + 1]) : null;

// RelatedPosts renders a card (image, category, title, excerpt) and picks
// its three entries from tags/category. Passing the full post objects
// serialized every article's entire markdown body into the island props:
// ~350 KB of HTML per article page, parsed before the hero could paint.
const relatedPool = allBlogPosts.map((x) => ({
  id: x.id,
  slug: x.slug,
  title: x.title,
  excerpt: x.excerpt,
  imageUrl: (x as typeof x & { imageUrl?: string }).imageUrl ?? x.heroImage,
  category: (x as typeof x & { category?: string }).category,
  tags: (x as typeof x & { tags?: string[] }).tags,
})) as unknown as typeof allBlogPosts;

// Render the markdown here rather than inside the client island, so neither
// `marked` nor the blog dataset (which the auto-linker imports) ends up in
// the browser bundle.
const contentHtml = formatContent(
  (p as typeof p & { content?: string }).content ?? '',
  p.id,
);

// The island renders `contentHtml`, so shipping the record it was compiled
// from would serialize the same article twice: 15 KB of raw markdown in
// `post.content` on top of the 35 KB of rendered HTML. Keep only what
// BlogPostHeader, BlogPostContent, AuthorCard and the page itself read.
const postForIsland = (() => {
  const o = p as typeof p & Record<string, unknown>;
  return {
    id: o.id,
    slug: o.slug,
    title: o.title,
    excerpt: o.excerpt,
    imageUrl: o.imageUrl ?? o.heroImage ?? o.image,
    heroImage: o.heroImage,
    date: o.date,
    category: o.category,
    readingTime: o.readingTime,
    tags: o.tags,
    author: o.author,
  } as unknown as typeof p;
})();

const jsonLd: Record<string, unknown>[] = [
  breadcrumbJsonLd([
    { name: 'Accueil', path: '/' },
    { name: 'Blog', path: '/blog' },
    { name: p.title, path: `/blog/${p.slug}` },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: p.title,
    description: p.excerpt,
    image: p.heroImage,
    datePublished: p.isoDate || undefined,
    dateModified: p.isoDate || undefined,
    mainEntityOfPage: absoluteUrl(`/blog/${p.slug}`),
    author: {
      '@type': 'Person',
      '@id': absoluteUrl('/a-propos') + '#matthieu',
      name: p.authorName,
      url: absoluteUrl('/a-propos'),
    },
    publisher: {
      '@type': 'Organization',
      name: 'Corse à moto',
      logo: { '@type': 'ImageObject', url: absoluteUrl('/logo.png') },
    },
  },
];

if (p.faq && p.faq.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: p.faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  });
}

// Title : the post titles are already SEO-crafted (2 300-3 500 word
// articles with hand-tuned titles), the legacy suffix " | Blog Moto Corse"
// pushed past 95 chars on most posts and got truncated by Google. Drop it,
// keep the raw title (Layout adds the global site_name in og:site_name
// anyway, so brand presence is preserved). Posts whose editorial H1 still
// exceeds ~62 chars carry a shorter `metaTitle` in their front matter.
const metaTitle = getBlogOverride(p.slug)?.metaTitle ?? p.title;

// Description : use the excerpt, but cap at 158 chars to stay under Google's
// snippet limit. Excerpts from blog overrides are already concise (140-180
// chars typical), so trimming is rare and never mid-sentence sensitive.
const rawExcerpt = (p.excerpt || '').replace(/\s+/g, ' ').trim();
const metaDescription = rawExcerpt.length > 158 ? rawExcerpt.slice(0, 155).trimEnd() + '…' : rawExcerpt;
---

<Layout
  title={metaTitle}
  description={metaDescription}
  path={`/blog/${p.slug}`}
  image={p.heroImage}
  preloadImage={p.heroImage}
  type="article"
  publishedTime={p.isoDate}
  authorName={p.authorName}
  jsonLd={jsonLd}
>
  <BlogPostDetailPage client:load post={postForIsland} contentHtml={contentHtml} prevPost={prevPost} nextPost={nextPost} allPosts={relatedPool} />

  {p.faq && p.faq.length > 0 && (
    <section class="bg-gray-50 py-12 md:py-16">
      <div class="container mx-auto px-4 max-w-4xl">
        <h2 class="text-3xl md:text-4xl font-bold mb-8 text-corsica-charcoal font-heading">
          Questions fréquentes
        </h2>
        <ul class="space-y-3">
          {p.faq.map((item) => (
            <li>
              <details class="group bg-white border border-gray-200 rounded-xl p-5 hover:shadow-soft transition-shadow">
                <summary class="cursor-pointer list-none flex items-start justify-between gap-4 text-lg font-semibold text-corsica-charcoal hover:text-corsica-azure transition-colors">
                  <span>{item.q}</span>
                  <span aria-hidden="true" class="mt-1 text-corsica-azure text-2xl leading-none transition group-open:rotate-45">+</span>
                </summary>
                <p class="mt-4 leading-relaxed text-gray-700">{item.a}</p>
              </details>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Layout>
