---
import Layout from '@/layouts/Layout.astro';
import BlogPostDetailPage from '@/components/pages/BlogPostDetailPage';
import { allBlogPosts } from '@/lib/data';
import { breadcrumbJsonLd } from '@/lib/seo';
import { absoluteUrl } from '@/lib/utils';

export async function getStaticPaths() {
  return allBlogPosts.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props as {
  p: (typeof allBlogPosts)[number] & { faq?: { q: string; a: string }[] };
};

const sorted = allBlogPosts.slice().sort((a, b) => (b.isoDate ?? '').localeCompare(a.isoDate ?? ''));
const idx = sorted.findIndex((x) => x.slug === p.slug);
const prevPost = idx > 0 ? sorted[idx - 1] : null;
const nextPost = idx >= 0 && idx < sorted.length - 1 ? sorted[idx + 1] : null;

const jsonLd: Record<string, unknown>[] = [
  breadcrumbJsonLd([
    { name: 'Accueil', path: '/' },
    { name: 'Blog', path: '/blog' },
    { name: p.title, path: `/blog/${p.slug}` },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: p.title,
    description: p.excerpt,
    image: p.heroImage,
    datePublished: p.isoDate || undefined,
    dateModified: p.isoDate || undefined,
    mainEntityOfPage: absoluteUrl(`/blog/${p.slug}`),
    author: {
      '@type': 'Person',
      '@id': absoluteUrl('/a-propos') + '#matthieu',
      name: p.authorName,
      url: absoluteUrl('/a-propos'),
    },
    publisher: {
      '@type': 'Organization',
      name: 'Corse à moto',
      logo: { '@type': 'ImageObject', url: absoluteUrl('/logo.png') },
    },
  },
];

if (p.faq && p.faq.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: p.faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  });
}

// Title : the post titles are already SEO-crafted (2 300-3 500 word
// articles with hand-tuned titles), the legacy suffix " | Blog Moto Corse"
// pushed past 95 chars on most posts and got truncated by Google. Drop it,
// keep the raw title (Layout adds the global site_name in og:site_name
// anyway, so brand presence is preserved).
const metaTitle = p.title;

// Description : use the excerpt, but cap at 158 chars to stay under Google's
// snippet limit. Excerpts from blog overrides are already concise (140-180
// chars typical), so trimming is rare and never mid-sentence sensitive.
const rawExcerpt = (p.excerpt || '').replace(/\s+/g, ' ').trim();
const metaDescription = rawExcerpt.length > 158 ? rawExcerpt.slice(0, 155).trimEnd() + '…' : rawExcerpt;
---

<Layout
  title={metaTitle}
  description={metaDescription}
  path={`/blog/${p.slug}`}
  image={p.heroImage}
  preloadImage={p.heroImage}
  type="article"
  publishedTime={p.isoDate}
  authorName={p.authorName}
  jsonLd={jsonLd}
>
  <BlogPostDetailPage client:load post={p} prevPost={prevPost} nextPost={nextPost} allPosts={allBlogPosts} />

  {p.faq && p.faq.length > 0 && (
    <section class="bg-gray-50 py-12 md:py-16">
      <div class="container mx-auto px-4 max-w-4xl">
        <h2 class="text-3xl md:text-4xl font-bold mb-8 text-corsica-charcoal font-heading">
          Questions fréquentes
        </h2>
        <ul class="space-y-3">
          {p.faq.map((item) => (
            <li>
              <details class="group bg-white border border-gray-200 rounded-xl p-5 hover:shadow-soft transition-shadow">
                <summary class="cursor-pointer list-none flex items-start justify-between gap-4 text-lg font-semibold text-corsica-charcoal hover:text-corsica-azure transition-colors">
                  <span>{item.q}</span>
                  <span aria-hidden="true" class="mt-1 text-corsica-azure text-2xl leading-none transition group-open:rotate-45">+</span>
                </summary>
                <p class="mt-4 leading-relaxed text-gray-700">{item.a}</p>
              </details>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Layout>
