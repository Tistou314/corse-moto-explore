---
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { allGasStations } from '@/lib/data';
import { breadcrumbJsonLd } from '@/lib/seo';

const strategic = allGasStations.filter((s) => s.strategic);
const byRegion = new Map<string, typeof allGasStations>();
for (const s of allGasStations) {
  const key = s.region ?? '—';
  byRegion.set(key, [...(byRegion.get(key) ?? []), s]);
}
const regions = [...byRegion.entries()].sort(([a], [b]) => a.localeCompare(b));
---

<Layout
  title="Stations-service en Corse pour les motards"
  description="Carte et liste des stations-service utiles aux motards en Corse, dont les stations stratégiques du Cap Corse, du centre montagneux et du Grand Sud."
  path="/stations-service"
  jsonLd={breadcrumbJsonLd([{ name: 'Accueil', path: '/' }, { name: 'Stations', path: '/stations-service' }])}
>
  <Navbar slot="header" />
  <Footer slot="footer" />

  <section class="container pt-12 md:pt-16">
    <Breadcrumbs items={[{ name: 'Accueil', path: '/' }, { name: 'Stations-service' }]} />
    <div class="mt-8 max-w-prose">
      <h1 class="font-serif text-[clamp(2rem,3vw+1rem,3.75rem)] font-medium leading-tight tracking-tight">Stations-service en Corse</h1>
      <p class="mt-6 text-lg text-text-secondary">
        {allGasStations.length} stations recensées, dont {strategic.length} stations stratégiques à connaître pour les portions où il vaut mieux faire le plein avant de partir.
      </p>
    </div>
  </section>

  <section class="container mt-16">
    <h2 class="font-serif text-3xl">Stations stratégiques</h2>
    <p class="mt-3 text-text-secondary max-w-prose">À retenir : Cap Corse, centre, Sartenais, sud profond. Faire le plein systématiquement avant ces tronçons.</p>
    <ul class="mt-10 grid gap-x-8 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
      {strategic.map((s) => (
        <li class="border-b border-border pb-4">
          <p class="font-serif text-lg">{s.name}</p>
          <p class="text-sm text-text-secondary">
            {s.brand}{s.brand && s.address ? ' · ' : ''}{s.address}
          </p>
          {s.openingHours && <p class="text-sm text-text-muted mt-1">Horaires : {s.openingHours}</p>}
        </li>
      ))}
    </ul>
  </section>

  <section class="container mt-24 mb-32">
    <h2 class="font-serif text-3xl">Toutes les stations par région</h2>
    <div class="mt-10 space-y-12">
      {regions.map(([region, list]) => (
        <div>
          <h3 class="font-serif text-xl border-b border-border pb-3">{region} <span class="text-text-muted text-sm">· {list.length}</span></h3>
          <ul class="mt-6 grid gap-x-8 gap-y-3 sm:grid-cols-2 lg:grid-cols-3">
            {list.map((s) => (
              <li class="text-sm text-text-secondary">
                <span class="text-text-primary">{s.name}</span>
                {s.brand && <span class="text-text-muted"> · {s.brand}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</Layout>
