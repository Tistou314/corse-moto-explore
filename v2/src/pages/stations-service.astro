---
import Layout from '@/layouts/Layout.astro';
import GasStationsPage from '@/components/pages/GasStationsPage';
import { allGasStations } from '@/lib/data';
import { breadcrumbJsonLd } from '@/lib/seo';

const strategicCount = allGasStations.filter((s) => (s as { strategic?: boolean }).strategic).length;
const jsonLd = breadcrumbJsonLd([
  { name: 'Accueil', path: '/' },
  { name: 'Stations-service', path: '/stations-service' },
]);
---

<Layout
  title="Stations-Service en Corse - Guide Complet pour Motards"
  description="Carte interactive des stations-service en Corse avec conseils de ravitaillement pour motards. Planifiez vos étapes essence sur les routes corses."
  path="/stations-service"
  jsonLd={jsonLd}
>
  <GasStationsPage client:load allStations={allGasStations} strategicCount={strategicCount} />
</Layout>
