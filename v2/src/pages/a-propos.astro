---
import Layout from '@/layouts/Layout.astro';
import { breadcrumbJsonLd, SITE_NAME } from '@/lib/seo';
import { SITE_URL, absoluteUrl } from '@/lib/utils';

const heroImage = '/lovable-uploads/1786ff52-abb7-4c35-9599-de33995c0358.png';

const values = [
  {
    title: "Tout est roulé avant d'être écrit",
    text: "Chaque itinéraire, chaque col, chaque conseil a été parcouru guidon en main. Aucune ligne n'est recopiée d'un dépliant touristique ou d'un autre blog.",
  },
  {
    title: 'Je dis aussi ce qui coince',
    text: "Routes dégradées, animaux sur la chaussée, hébergements complets dès mai, stations rares dans l'intérieur : je préfère prévenir que faire rêver à vide.",
  },
  {
    title: 'Indépendance totale',
    text: "Aucun partenariat rémunéré, aucun lien d'affiliation maquillé, aucun hébergement listé en échange d'une nuit gratuite. Le projet est financé sur fonds propres.",
  },
  {
    title: 'Un guide vivant',
    text: "La Corse change au fil des saisons et des années. Je mets à jour, je corrige, je complète. Tes retours par le formulaire de contact nourrissent directement le travail.",
  },
];

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': absoluteUrl('/a-propos') + '#matthieu',
  name: 'Matthieu',
  jobTitle: 'Fondateur et rédacteur de Corse à moto',
  description:
    "Motard originaire de Haute-Savoie, je documente mes voyages à moto en Corse depuis 2022 sur ce site indépendant.",
  url: absoluteUrl('/a-propos'),
  knowsAbout: ['Voyage à moto', 'Corse', "Itinéraires moto", 'Cols corses', 'Hébergements motards'],
  worksFor: {
    '@type': 'Organization',
    name: SITE_NAME,
    url: SITE_URL,
  },
};

const jsonLd: Record<string, unknown>[] = [
  breadcrumbJsonLd([
    { name: 'Accueil', path: '/' },
    { name: 'À propos', path: '/a-propos' },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: `À propos de ${SITE_NAME}`,
    url: absoluteUrl('/a-propos'),
    author: personJsonLd,
    about: {
      '@type': 'Organization',
      name: SITE_NAME,
      description:
        "Guide indépendant des voyages moto en Corse, écrit en solo par Matthieu, qui sillonne l'île à moto chaque année depuis 2022.",
      founder: personJsonLd,
      url: SITE_URL,
    },
  },
  personJsonLd,
];
---

<Layout
  title="À propos : qui écrit Corse à moto"
  description="Corse à moto est tenu par un seul motard, Matthieu, qui documente ses voyages sur l'île depuis 2022. Sans équipe ni partenariats : un carnet de route détaillé."
  path="/a-propos"
  image={heroImage}
  preloadImage={heroImage}
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="relative">
    <img
      src={heroImage}
      alt="Vue depuis la selle d'une moto sur une route côtière des calanques de Corse"
      width="1200"
      height="675"
      fetchpriority="high"
      loading="eager"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-corsica-charcoal/70 via-corsica-charcoal/55 to-corsica-charcoal/80"></div>
    <div class="relative container mx-auto px-4 py-32 md:py-44 text-center">
      <p class="text-corsica-coral font-semibold tracking-wide uppercase text-sm mb-4">Qui écrit ici</p>
      <h1 class="text-4xl md:text-6xl font-bold text-white font-heading mb-6 max-w-3xl mx-auto">
        Un guide tenu par un seul motard, pas par une rédaction
      </h1>
      <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto leading-relaxed">
        Corse à moto, c'est mon carnet de route depuis 2022. Tout ce que tu lis ici, c'est ce
        que j'ai roulé moi-même, vérifié sur place, et choisi de te transmettre.
      </p>
    </div>
  </section>

  <!-- Genèse -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4 max-w-3xl">
      <h2 class="text-3xl md:text-4xl font-bold mb-8 text-corsica-charcoal font-heading">
        Comment tout a commencé
      </h2>
      <div class="space-y-5 text-lg text-corsica-slate leading-relaxed">
        <p>
          Je m'appelle Matthieu, j'ai 38 ans, je vis en Haute-Savoie et je suis venu à la
          moto sur le tard : permis A en poche à 31 ans. Ma première Corse, c'était en mai
          2022 : une traversée Nice-Bastia décidée presque sur un coup de tête, dix jours
          devant moi, une Yamaha Tracer 700 chargée à la va-vite. Je suis reparti convaincu
          que je reviendrais. J'y suis retourné chaque année depuis, parfois deux fois.
        </p>
        <p>
          À chaque voyage, je note. Les virages qui méritent qu'on coupe le moteur, la
          station-service qu'il ne faut pas rater avant l'intérieur, l'hôtel qui accepte les
          motos dans la cour fermée, la terrasse où l'on mange vraiment bien pour 18 €. Au
          bout de cinq ou six séjours, ce carnet est devenu trop précieux pour rester dans
          une sacoche. J'ai monté ce site fin 2025 pour le partager.
        </p>
        <p>
          Ce n'est pas un site d'agence. Ce n'est pas une rédaction de cinq personnes. C'est
          un projet personnel, financé sur mes propres deniers, écrit par moi seul, qui
          assume sa subjectivité et qui essaie d'être utile à qui prépare un premier voyage
          comme à qui revient pour la cinquième fois. Je le mets à jour quand je rentre d'un
          séjour, et je corrige quand un lecteur me signale qu'un hébergement a fermé ou
          qu'une route a été refaite.
        </p>
        <p>
          Si tu prépares ton voyage moto en Corse, j'espère que ce que tu liras ici te fera
          gagner du temps, te fera éviter les pièges classiques, et surtout te fera rouler les
          bonnes routes plutôt que celles que tout le monde te recommande sans y être allé.
        </p>
      </div>
    </div>
  </section>

  <!-- Profil auteur -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto bg-white rounded-2xl shadow-soft p-8 md:p-10">
        <div class="flex flex-col sm:flex-row items-start gap-6 mb-8">
          <div class="bg-corsica-azure text-white w-20 h-20 rounded-full flex items-center justify-center font-bold text-3xl flex-shrink-0">
            M
          </div>
          <div class="flex-1">
            <h2 class="text-2xl md:text-3xl font-bold text-corsica-charcoal font-heading mb-2">
              Matthieu
            </h2>
            <p class="text-corsica-coral font-semibold mb-3">Fondateur, rédacteur, photographe</p>
            <p class="text-corsica-slate leading-relaxed">
              Originaire de Haute-Savoie, venu à la moto à 31 ans, je roule en Corse en moyenne
              une à deux fois par an depuis 2022. Trail polyvalent (Tracer 700 puis 890
              Adventure), un appareil photo toujours dans la sacoche, et une vraie obsession
              pour les routes secondaires que personne ne prend.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 py-6 border-y border-gray-200 mb-8">
          <div>
            <p class="text-2xl font-bold text-corsica-azure font-heading">2022</p>
            <p class="text-sm text-corsica-slate">Premier voyage</p>
          </div>
          <div>
            <p class="text-2xl font-bold text-corsica-azure font-heading">6</p>
            <p class="text-sm text-corsica-slate">Séjours sur l'île</p>
          </div>
          <div>
            <p class="text-2xl font-bold text-corsica-azure font-heading">8 000+</p>
            <p class="text-sm text-corsica-slate">Km parcourus en Corse</p>
          </div>
          <div>
            <p class="text-2xl font-bold text-corsica-azure font-heading">100 %</p>
            <p class="text-sm text-corsica-slate">Contenu vérifié sur place</p>
          </div>
        </div>

        <div class="space-y-4 text-corsica-slate leading-relaxed">
          <p>
            <strong class="text-corsica-charcoal">Ce que je connais bien :</strong> les
            intersaisons (mai-juin et septembre-octobre, mes périodes préférées), les routes
            de l'intérieur (cap Corse, Castagniccia, Niolu, Bavella), la logistique d'un road
            trip solo ou en petit groupe, la préparation mécanique d'un trail pour les routes
            corses, et le repérage des hébergements vraiment adaptés aux motards.
          </p>
          <p>
            <strong class="text-corsica-charcoal">Ce que je connais moins :</strong> la haute
            saison (juillet-août, je l'évite, donc mon recul est limité), le Sud extrême
            (Bonifacio et Sartène, j'y suis allé 3 fois seulement), et la conduite hivernale
            sérieuse (je n'ai jamais roulé en Corse en janvier ou février. Si tu l'as fait,
            écris-moi, j'aimerais beaucoup en parler).
          </p>
          <p>
            <strong class="text-corsica-charcoal">Pour me contacter :</strong> le
            <a href="/contact" class="text-corsica-azure hover:underline font-medium">formulaire de contact</a>
            est le moyen le plus simple. Je réponds en général sous une semaine. N'hésite
            pas à me corriger si une info est obsolète, à me proposer une adresse, ou à me
            poser une question précise sur ton itinéraire.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Valeurs -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center mb-14">
        <h2 class="text-3xl md:text-4xl font-bold mb-4 text-corsica-charcoal font-heading">
          Ma méthode
        </h2>
        <p class="text-lg text-corsica-slate leading-relaxed">
          Quatre principes qui guident chaque ligne publiée sur ce site.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {values.map((v, i) => (
          <div class="border border-gray-200 rounded-xl p-6 hover:shadow-soft transition-shadow">
            <div class="flex items-start gap-4">
              <span class="text-2xl font-bold text-corsica-azure/40 font-heading leading-none">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="font-bold text-lg text-corsica-charcoal font-heading mb-2">{v.title}</h3>
                <p class="text-corsica-slate leading-relaxed">{v.text}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 md:py-20 bg-corsica-charcoal">
    <div class="container mx-auto px-4 text-center max-w-2xl">
      <h2 class="text-3xl md:text-4xl font-bold mb-4 text-white font-heading">
        Prêt à tracer ta route ?
      </h2>
      <p class="text-lg text-white/80 mb-8 leading-relaxed">
        Parcours les itinéraires que j'ai testés sur le terrain, ou écris-moi pour partager
        une adresse, corriger une info ou poser une question précise.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/itineraires"
          class="bg-corsica-coral text-white font-semibold px-6 py-3 rounded-full hover:bg-corsica-coral/90 transition-colors"
        >
          Voir les itinéraires
        </a>
        <a
          href="/contact"
          class="bg-white/10 text-white font-semibold px-6 py-3 rounded-full border border-white/20 hover:bg-white/20 transition-colors"
        >
          M'écrire
        </a>
      </div>
    </div>
  </section>
</Layout>
