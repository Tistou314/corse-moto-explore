---
import Layout from '@/layouts/Layout.astro';
import { breadcrumbJsonLd, SITE_NAME } from '@/lib/seo';
import { SITE_URL } from '@/lib/utils';

const heroImage = '/lovable-uploads/1786ff52-abb7-4c35-9599-de33995c0358.png';

const team = [
  {
    name: 'Matthieu',
    role: 'Fondateur & rédacteur en chef',
    initials: 'M',
    color: 'bg-corsica-azure',
    bio: "Originaire de Haute-Savoie, il a découvert la Corse par hasard lors d'un voyage improvisé et n'a plus jamais cessé d'y revenir. Huit ans à sillonner l'île, un carnet de routes qui ne cesse de grossir, et un appareil photo toujours dans la sacoche. C'est lui qui a lancé le guide, et qui en tient encore la plume principale.",
  },
  {
    name: 'Sophie Mercier',
    role: 'Référente saisons & météo',
    initials: 'SM',
    color: 'bg-corsica-emerald',
    bio: "Elle a fait des intersaisons corses sa spécialité : avril, mai, septembre, octobre. À force d'y retourner aux mêmes périodes année après année, elle sait quand un col rouvre, quand le maquis embaume, et quand une route bascule de l'idéal au piège.",
  },
  {
    name: 'Michel Vasseur',
    role: 'Référent mécanique & préparation',
    initials: 'MV',
    color: 'bg-corsica-coral',
    bio: "Mécanicien moto spécialisé dans la préparation des machines pour les terrains exigeants. Revêtements capricieux, dénivelés, chaleur : il traduit l'expérience de l'atelier en check-lists concrètes pour que personne ne se retrouve en rade sur une route isolée.",
  },
  {
    name: 'Marc Dubreuil',
    role: 'Organisation & logistique des voyages',
    initials: 'MD',
    color: 'bg-corsica-azure',
    bio: "Organisateur de voyages moto à destination de la Corse depuis 2010. Ferry, étapes, hébergements, ravitaillement : il sait où ça coince et comment l'éviter. C'est lui qui transforme une envie de road trip en itinéraire qui tient debout.",
  },
  {
    name: 'Julien Faure',
    role: "Spécialiste de l'été corse",
    initials: 'JF',
    color: 'bg-corsica-emerald',
    bio: "Motard expérimenté, il a parcouru l'île pendant plus de quinze étés consécutifs. Gestion de la chaleur, créneaux horaires, hydratation, choix d'équipement : il sait rendre la haute saison supportable, voire belle.",
  },
  {
    name: 'Pierre-Antoine Granger',
    role: 'Spécialiste hors-saison & conduite difficile',
    initials: 'PG',
    color: 'bg-corsica-coral',
    bio: "Motard tout-terrain et moniteur de conduite hivernale. Quand les cols se couvrent et que l'île se vide, c'est son domaine. Il documente la Corse des saisons creuses, celle que peu de gens osent rouler.",
  },
];

const values = [
  {
    title: 'Tout est roulé avant d’être écrit',
    text: "Chaque itinéraire, chaque col, chaque conseil a été parcouru guidon en main. Rien n'est recopié d'un dépliant touristique.",
  },
  {
    title: 'On dit aussi ce qui coince',
    text: "Routes dégradées, animaux sur la chaussée, hébergements complets dès mai, stations rares dans l'intérieur : on préfère prévenir que faire rêver à vide.",
  },
  {
    title: 'Des voix différentes, un même terrain',
    text: "Mécanique, saisons, photo, logistique : chacun écrit sur ce qu'il connaît vraiment. Le guide est la somme de ces regards, pas d'une plume unique.",
  },
  {
    title: 'Un guide vivant',
    text: "La Corse change au fil des saisons et des années. On met à jour, on corrige, on complète. Vos retours par le formulaire de contact nourrissent directement le travail.",
  },
];

const jsonLd: Record<string, unknown>[] = [
  breadcrumbJsonLd([
    { name: 'Accueil', path: '/' },
    { name: 'À propos', path: '/a-propos' },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: `À propos — ${SITE_NAME}`,
    url: `${SITE_URL.replace(/\/$/, '')}/a-propos`,
    about: {
      '@type': 'Organization',
      name: SITE_NAME,
      description:
        "Guide indépendant des voyages moto en Corse, écrit par une équipe de motards, mécaniciens, guides et photographes qui connaissent l'île de l'intérieur.",
      member: team.map((m) => ({
        '@type': 'Person',
        name: m.name,
        jobTitle: m.role,
      })),
    },
  },
];
---

<Layout
  title="À propos — l'équipe derrière Corse à moto"
  description="Comment ce guide moto de la Corse est né de plusieurs voyages sur l'île, et qui sont les motards, guides et mécaniciens qui l'écrivent."
  path="/a-propos"
  image={heroImage}
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="relative">
    <img
      src={heroImage}
      alt="Vue depuis la selle d'une moto sur une route côtière des calanques de Corse"
      width="1200"
      height="675"
      fetchpriority="high"
      loading="eager"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-corsica-charcoal/70 via-corsica-charcoal/55 to-corsica-charcoal/80"></div>
    <div class="relative container mx-auto px-4 py-32 md:py-44 text-center">
      <p class="text-corsica-coral font-semibold tracking-wide uppercase text-sm mb-4">Notre histoire</p>
      <h1 class="text-4xl md:text-6xl font-bold text-white font-heading mb-6 max-w-3xl mx-auto">
        Un guide né sur la route, pas derrière un bureau
      </h1>
      <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto leading-relaxed">
        Corse à moto, c'est l'addition de plusieurs voyages, de milliers de virages et
        d'une bande de passionnés qui ont fini par mettre tout ça noir sur blanc.
      </p>
    </div>
  </section>

  <!-- Genèse -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4 max-w-3xl">
      <h2 class="text-3xl md:text-4xl font-bold mb-8 text-corsica-charcoal font-heading">
        Comment tout a commencé
      </h2>
      <div class="space-y-5 text-lg text-corsica-slate leading-relaxed">
        <p>
          Tout est parti d'un voyage improvisé. Une traversée en ferry décidée presque à la
          dernière minute, une moto chargée à la va-vite, et dix jours devant soi. Ce premier
          contact avec la Corse a suffi : les routes qui se tordent au-dessus de la mer, le
          granit rouge de Piana, le silence des villages perchés, la fraîcheur d'un col après
          la fournaise de la côte. On repart en se promettant de revenir.
        </p>
        <p>
          Et on revient. Une fois, puis chaque année. À force de rouler l'île, un carnet se
          remplit : les virages qui méritent qu'on ralentisse, la station-service qu'il ne
          faut pas rater avant l'intérieur, l'hôtel qui accepte les motos dans la cour, la
          terrasse où l'on mange vraiment bien. Ce carnet, d'abord griffonné pour soi, est
          devenu trop précieux pour rester dans une sacoche.
        </p>
        <p>
          Au fil des voyages, les rencontres font le reste. Un mécanicien qui explique
          pourquoi une moto continentale souffre sur les revêtements corses. Une motarde qui
          lit les intersaisons de l'île mieux que n'importe quelle appli météo. Un organisateur
          qui connaît chaque écueil logistique d'un road trip insulaire. Chacun avait sa pièce
          du puzzle. Corse à moto est né de l'envie de les rassembler.
        </p>
        <p>
          Aujourd'hui, ce guide n'est ni un catalogue ni une brochure. C'est un travail de
          terrain, tenu par des gens qui roulent vraiment ici, et qui écrivent pour que votre
          voyage ressemble au leur : libre, préparé, et fidèle à ce qu'est l'île.
        </p>
      </div>
    </div>
  </section>

  <!-- Équipe -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center mb-14">
        <h2 class="text-3xl md:text-4xl font-bold mb-4 text-corsica-charcoal font-heading">
          L'équipe
        </h2>
        <p class="text-lg text-corsica-slate leading-relaxed">
          Six regards sur la même île. Chacun écrit sur ce qu'il connaît le mieux, et c'est
          ce qui fait la richesse du guide.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {team.map((m) => (
          <article class="bg-white rounded-xl shadow-soft p-6 flex flex-col">
            <div class="flex items-center gap-4 mb-4">
              <div class={`${m.color} text-white w-14 h-14 rounded-full flex items-center justify-center font-bold text-lg flex-shrink-0`}>
                {m.initials}
              </div>
              <div>
                <h3 class="font-bold text-lg text-corsica-charcoal font-heading leading-tight">{m.name}</h3>
                <p class="text-sm text-corsica-coral font-medium">{m.role}</p>
              </div>
            </div>
            <p class="text-corsica-slate leading-relaxed text-[15px]">{m.bio}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Valeurs -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center mb-14">
        <h2 class="text-3xl md:text-4xl font-bold mb-4 text-corsica-charcoal font-heading">
          Ce qui nous tient à cœur
        </h2>
        <p class="text-lg text-corsica-slate leading-relaxed">
          Quatre principes qui guident chaque ligne publiée sur ce site.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {values.map((v, i) => (
          <div class="border border-gray-200 rounded-xl p-6 hover:shadow-soft transition-shadow">
            <div class="flex items-start gap-4">
              <span class="text-2xl font-bold text-corsica-azure/40 font-heading leading-none">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="font-bold text-lg text-corsica-charcoal font-heading mb-2">{v.title}</h3>
                <p class="text-corsica-slate leading-relaxed">{v.text}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 md:py-20 bg-corsica-charcoal">
    <div class="container mx-auto px-4 text-center max-w-2xl">
      <h2 class="text-3xl md:text-4xl font-bold mb-4 text-white font-heading">
        Prêt à tracer votre route ?
      </h2>
      <p class="text-lg text-white/80 mb-8 leading-relaxed">
        Parcourez nos itinéraires testés sur le terrain, ou écrivez-nous pour partager une
        adresse, corriger une info ou poser une question.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/itineraires"
          class="bg-corsica-coral text-white font-semibold px-6 py-3 rounded-full hover:bg-corsica-coral/90 transition-colors"
        >
          Voir les itinéraires
        </a>
        <a
          href="/contact"
          class="bg-white/10 text-white font-semibold px-6 py-3 rounded-full border border-white/20 hover:bg-white/20 transition-colors"
        >
          Nous contacter
        </a>
      </div>
    </div>
  </section>
</Layout>
